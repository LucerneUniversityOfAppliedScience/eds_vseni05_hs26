{
  "datasets": [
    {
      "name": "ds_daily",
      "displayName": "Daily traffic and weather",
      "queryLines": [
        "SELECT date, year, is_weekend, dayofweek(date) AS weekday_num, date_format(date, 'EEE') AS weekday, bikes_per_station, pedestrians_per_station, vehicles_per_site, temp_mean_c, precipitation_mm, IF(is_rainy_day, 'rainy (>= 1 mm)', 'dry') AS weather, CASE WHEN is_rainy_day THEN 1 ELSE 0 END AS rainy_day FROM workspace.mobility_pipeline.daily_traffic WHERE year BETWEEN 2011 AND 2026 ORDER BY date"
      ]
    },
    {
      "name": "ds_yearly",
      "displayName": "Yearly trend",
      "queryLines": [
        "SELECT make_date(year, 1, 1) AS year_start, avg_daily_bikes_per_station, avg_daily_vehicles_per_site, avg_active_bike_stations FROM workspace.mobility_pipeline.yearly_trend ORDER BY year"
      ]
    },
    {
      "name": "ds_profile",
      "displayName": "Hourly profile 2025",
      "queryLines": [
        "SELECT mode, day_type, hour, avg_per_location FROM workspace.mobility_pipeline.hourly_profile ORDER BY hour"
      ]
    },
    {
      "name": "ds_locations",
      "displayName": "Counting locations 2025",
      "queryLines": [
        "SELECT mode, location_name, lat, lon, avg_daily_count FROM workspace.mobility_pipeline.location_map"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Overview",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "## Bike vs. car in Zurich\n",
                "\n",
                "Automatic bike, pedestrian and motorized traffic counts of the City of Zurich (Open Data, CC0) joined with weather data from Open-Meteo (CC BY 4.0). Values are averages per active counting station / site and day, because the number of stations changes over time."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "filter_date",
            "queries": [
              {
                "name": "q_daily",
                "query": {
                  "datasetName": "ds_daily",
                  "fields": [
                    {
                      "name": "date",
                      "expression": "`date`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-date-range-picker",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "date",
                    "displayName": "Date",
                    "queryName": "q_daily"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Period"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi_bikes",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily",
                  "fields": [
                    {
                      "name": "avg(bikes_per_station)",
                      "expression": "AVG(`bikes_per_station`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "avg(bikes_per_station)",
                  "displayName": "Bikes per station and day",
                  "format": {
                    "type": "number",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Bikes per station and day",
                "description": "Average over the selected period",
                "showDescription": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 4,
            "width": 4,
            "height": 3
          }
        },
