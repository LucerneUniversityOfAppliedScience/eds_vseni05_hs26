# Copy to .env (never commit .env). All values optional – without them the collector calls OpenSky anonymously and
# the backfill is skipped.

# OpenSky account (4,000 credits per day instead of 400 per IP address – a classroom often shares one IP address)
# https://opensky-network.org -> Account -> API client
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Class data in the private Cloudflare R2 bucket – READ-ONLY key from your teacher
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com/<bucket>
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Aircraft photos (planespotters.net) – their terms ask for a contact in every request: your own e-mail address.
# Without it the app simply shows no photos.
PHOTO_CONTACT=

# The app: also show the rest of the world from the class bucket (every 6 min, ~13,000 aircraft) – needs the R2 key
# R2_REGIONS=world

# The app: seconds between OpenSky calls at start (changeable in the app). 35 = one day on an account's 4,000 credits
# INTERVAL=35
